# FaceForge 环境变量样例(复制为 .env 使用)

# API 网关
API_HOST=0.0.0.0
API_PORT=8000

# face-engine 模型缓存目录(容器内挂载卷)
FACEFORGE_MODELS_DIR=/models
# 本机原生运行时的 FaceFusion 目录、独立 Python 与执行后端
FACEFORGE_FACEFUSION_DIR=/path/to/facefusion
FACEFORGE_FACEFUSION_PYTHON=/path/to/facefusion/.venv/bin/python
FACEFORGE_EXECUTION_PROVIDERS=coreml
# 换脸/增强默认档位
FACEFORGE_SWAPPER=hyperswap_1a_256
FACEFORGE_FACE_ENHANCER=codeformer
FACEFORGE_OCCLUSION_MASK=true

# GPU
NVIDIA_VISIBLE_DEVICES=all

# Web
NEXT_PUBLIC_API_BASE=http://localhost:8000
