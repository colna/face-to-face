# FaceForge face-engine —— 需 NVIDIA GPU 机器构建/运行(sandbox 无 GPU,仅代码)
FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    FACEFORGE_MODELS_DIR=/models

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.10 python3-pip ffmpeg libgl1 libglib2.0-0 git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY services/face-engine/pyproject.toml ./services/face-engine/
COPY services/face-engine/engine ./services/face-engine/engine
# onnxruntime-gpu / facefusion / deep-live-cam 依赖在有卡机器安装(体积大,不入基础层)
RUN pip3 install --no-cache-dir -e "services/face-engine" \
    && pip3 install --no-cache-dir onnxruntime-gpu

VOLUME ["/models"]
# 引擎作为库被 api 导入;独立调试时可跑自检
CMD ["python3", "-c", "import engine; print('faceforge-engine', engine.__version__)"]
